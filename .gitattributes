# Fichiers présents dans le dépôt mais qui ne doivent pas partir
# dans le paquet d'installation (git archive respecte export-ignore).
#
# Le guide d'installation, lui, EST livré : c'est la notice du client.

# Notes de suivi internes du projet (état de l'agent, résumés d'avancement).
Resume-*.pdf export-ignore
Etat-agent-*.pdf export-ignore

# Ancienne notice détaillée, remplacée par INSTALLATION.md et par la fiche
# d'une page INSTALLER-EN-5-ETAPES.pdf.
Installation-Infirmerie-*.pdf export-ignore

# Outils d'exposition réseau : ils n'ont rien à faire sur le poste qui
# contient les dossiers réels. Une fausse manipulation suffirait à publier
# l'application sur Internet. L'accès distant passe par le VPN, expliqué
# dans le guide.
demo_tunnel.py export-ignore
ouvrir_pare-feu.bat export-ignore
demarrer_reseau.bat export-ignore
demarrer_reseau.py export-ignore

# Générateurs de documents internes.
generer_resume_pdf.py export-ignore
generer_etat_agent_pdf.py export-ignore
generer_installation_pdf.py export-ignore

# Mode demonstration : inutile chez le client, et dangereux par confusion.
# Cette base n'a ni comptes ni dossiers : le lanceur y mene a un ecran de
# connexion qui refuse tout, sans explication.
demarrer_demo.bat export-ignore

# Fichiers de développement
.gitattributes export-ignore
.gitignore export-ignore

# Binaires : jamais de conversion de fins de ligne.
*.pdf binary
*.woff2 binary
*.zip binary
