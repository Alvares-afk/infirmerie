# Exemple de configuration d'environnement.
# Copier en « .env » ou « secret.env » et remplir les valeurs réelles.
# Ce fichier ne contient que la FORME des variables : aucun secret.

# --- Obligatoire en production -------------------------------------------
# Cette clé signe les cookies de session. Qui la possède peut forger une
# session administrateur. Elle ne doit jamais être écrite ailleurs.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
INFIRMERIE_SECRET_KEY=

# --- Recommandé en production ---------------------------------------------
# "0" ou "false" désactive les traces d'erreur détaillées.
INFIRMERIE_DEBUG=1

# Hôtes autorisés, séparés par des virgules. En accès local : 127.0.0.1
INFIRMERIE_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Optionnel -------------------------------------------------------------
# Journal d'accès : "0" pour désactiver la traçabilité.
INFIRMERIE_JOURNAL=1

# Durée de conservation du journal, en jours.
INFIRMERIE_JOURNAL_JOURS=3650

# Origines autorisées à envoyer un formulaire CSRF.
# À remplir UNIQUEMENT si un proxy inverse est devant l'application.
INFIRMERIE_CSRF_TRUSTED=
